# THEN configuration. Copy to .env and fill in what you need; .env is git-ignored.
# The web app and the CLI both read this file from the repository root.

# Nansen API key. Required to stamp; everything else (replays, verification, the Challenge on
# published receipts) works without it. Server-side only: it is never sent to the browser.
NANSEN_API_KEY=

# ---------------------------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------------------------

# Postgres for a hosted deployment. Leave empty locally to use the embedded store in .then/pglite.
DATABASE_URL=

# Where the embedded local store lives (default .then/pglite).
# THEN_PGLITE_DIR=.then/pglite

# 64 hex characters (32 bytes) each. Required in production; generated under .then/keys in
# development. Generate with: openssl rand -hex 32
THEN_RECEIPT_SIGNING_KEY=
THEN_SESSION_SECRET=

# Extra public keys this deployment trusts, as role:hexkey separated by commas. Roles: hosted,
# local, fixture. Use it to accept receipts stamped with the CLI (`pnpm then keys` prints yours).
THEN_TRUSTED_RECEIPT_KEYS=

# Public URL of the deployment, used in receipt links, share cards, and the sitemap.
THEN_PUBLIC_BASE_URL=http://localhost:3000

# Stamps allowed per visitor per hour (default 10).
THEN_STAMP_LIMIT_PER_HOUR=10

# paper (default) records a hashed intent; live asks Nansen for an unsigned transaction.
THEN_TRADE_MODE=paper

# Operator routes (/api/internal/*): off unless both are set.
THEN_ENABLE_INTERNAL_ROUTES=0
THEN_ADMIN_TOKEN=

# Wallet-level detail on public pages. Leave at 0 unless Nansen has approved it in writing.
THEN_PUBLIC_MEMBERSHIP_DETAIL=0

# Repository link shown on the site.
THEN_GITHUB_URL=https://github.com/winsznx/then

# ---------------------------------------------------------------------------------------------
# Both
# ---------------------------------------------------------------------------------------------

# 1 switches off every Nansen point-in-time endpoint. Every stamp then returns INSUFFICIENT;
# this is the ablation check, not a normal setting.
THEN_DISABLE_HISTORICAL=0

# CLI signing role when THEN_RECEIPT_SIGNING_KEY is set for the CLI: local (default) or hosted.
# THEN_RECEIPT_KEY_ROLE=local
