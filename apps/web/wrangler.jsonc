{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "then",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  // Runs the Worker near the database it talks to (one region) rather than near each visitor.
  "placement": { "mode": "smart" },
  // Non-secret configuration. Secrets (NANSEN_API_KEY, DATABASE_URL, THEN_RECEIPT_SIGNING_KEY,
  // THEN_SESSION_SECRET, THEN_ADMIN_TOKEN) are set with `wrangler secret put`.
  "vars": {
    "NODE_ENV": "production",
    "THEN_TRADE_MODE": "paper",
    "THEN_STAMP_LIMIT_PER_HOUR": "10",
    "THEN_GITHUB_URL": "https://github.com/winsznx/then",
  },
}
